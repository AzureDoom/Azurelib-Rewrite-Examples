{
  "schemaVersion": 1,
  "id": "azexamples",
  "version": "${version}",

  "name": "AzureLib Examples",
  "description": "Example entities, items, armor and blocks for AzureLib on Beta 1.7.3 (StationAPI).",
  "authors": [
    "AzureDoom"
  ],
  "contact": {
    "sources": "https://github.com/AzureDoom/AzureLib"
  },

  "license": "MIT",
  "icon": "logo.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "mod.azure.azexamples.registry.ExamplesEvents"
    ],
    "stationapi:event_bus_client": [
      "mod.azure.azexamples.client.ExamplesClientEvents"
    ]
  },
  "mixins": [
    "azexamples.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "fabricloader": ">=0.19.5",
    "stationapi": "*",
    "azurelib": "*"
  }
}
