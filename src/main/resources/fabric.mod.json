{
  "schemaVersion": 1,
  "id": "azexamples",
  "version": "${version}",
  "name": "AzureLib Examples",
  "description": "Example entities, items, armor and blocks for AzureLib on Beta 1.7.3 (Ornithe).",
  "authors": [
    "AzureDoom"
  ],
  "contact": {
    "sources": "https://github.com/AzureDoom/AzureLib"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "init": [
      "mod.azure.azexamples.ExamplesMod"
    ],
    "client-init": [
      "mod.azure.azexamples.client.ExamplesClient"
    ]
  },
  "mixins": [
    "azexamples.mixins.json"
  ],
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "fabricloader": ">=0.19.5",
    "osl-entrypoints": "*",
    "osl-blocks": "*",
    "osl-items": "*",
    "azurelib": "*"
  }
}
